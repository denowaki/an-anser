    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.7",
    "@types/node": "^22.10.7",
    "@types/cors": "^2.8.17"
  },
  "engines": {
    "node": ">=18"
  }
}
